# Supabase Configuration Template
# Copy this file to .env and fill in your actual values

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_PASSWORD=your_database_password_here

# Cloud Translation API key (basic v2). Enable Cloud Translation on the Google Cloud project.
GOOGLE_TRANSLATE_API_KEY=

# Or a service-account JSON file, instead of an API key:
# GOOGLE_APPLICATION_CREDENTIALS=secrets/translate-service-account.json
